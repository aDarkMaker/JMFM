#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [[ -n "${JMFM_SKIP_VERSION_BUMP:-}" ]]; then
  exit 0
fi

remote="${1:-}"
url="${2:-}"

if [[ "$remote" != "origin" ]]; then
  exit 0
fi

pushing_main=false
while read -r local_ref local_oid remote_ref remote_oid; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    pushing_main=true
    break
  fi
done

if [[ "$pushing_main" != "true" ]]; then
  exit 0
fi

prompt_tty=/dev/tty
if [[ ! -w "$prompt_tty" ]]; then
  case "${JMFM_VERSION_BUMP:-skip}" in
    minor|major)
      choice=$([[ "$JMFM_VERSION_BUMP" == minor ]] && echo 1 || echo 2)
      ;;
    *)
      echo "Non-interactive push: skipping version bump (set JMFM_VERSION_BUMP=minor|major to bump)."
      exit 0
      ;;
  esac
else
  {
    echo ""
    echo "JMFM push to main — select version bump:"
    echo "  1) 小版本 (minor)  e.g. 1.0.0 → 1.1.0"
    echo "  2) 大版本 (major)  e.g. 1.1.0 → 2.0.0"
    echo "  3) 跳过 (no bump)"
    echo ""
    printf "Choice [1-3]: "
  } > "$prompt_tty"
  read -r choice < "$prompt_tty"
fi

bumped=false
case "$choice" in
  1)
    bun scripts/bump-version.ts minor
    git add version.json package.json
    git commit -m "chore: bump version to $(bun -e "import {readVersion} from './scripts/read-version.ts'; console.log(readVersion().version)")"
    bumped=true
    ;;
  2)
    bun scripts/bump-version.ts major
    git add version.json package.json
    git commit -m "chore: bump version to $(bun -e "import {readVersion} from './scripts/read-version.ts'; console.log(readVersion().version)")"
    bumped=true
    ;;
  3|*)
    echo "Skipping version bump."
    ;;
esac

if [[ "$bumped" == "true" ]]; then
  echo "Pushing version bump commit ..."
  JMFM_SKIP_VERSION_BUMP=1 git push "$remote" HEAD:refs/heads/main
fi

exit 0
