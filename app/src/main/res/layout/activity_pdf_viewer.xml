<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:fitsSystemWindows="false"
    tools:context=".PDFViewerActivity">

    <!-- 自定义顶部边框 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/card_background"
        android:gravity="center_vertical"
        android:elevation="4dp"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <!-- 返回按钮 - 白色加粗箭头，与文字对齐 -->
        <ImageButton
            android:id="@+id/pdf_back_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_bold"
            android:contentDescription="返回"
            android:scaleType="centerInside" />

        <!-- PDF名称 -->
        <TextView
            android:id="@+id/pdf_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:text="PDF预览"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/aaguxilazhangguankeaideshen_2"
            android:singleLine="true"
            android:ellipsize="end"
            android:gravity="start|center_vertical" />

    </LinearLayout>

    <!-- PDF显示区域 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 全屏长条滚动PDF显示 -->
        <com.github.barteksc.pdfviewer.PDFView
            android:id="@+id/pdfView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/white" />

        <!-- 加载指示器 -->
        <ProgressBar
            android:id="@+id/pdf_progress"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent_primary"
            android:visibility="visible" />

    </FrameLayout>

</LinearLayout>
