<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pdf_list_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/pdf_list_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/card_background"
        android:paddingTop="0dp"
        android:gravity="center_vertical"
        app:titleTextAppearance="@style/PDFToolbarTitleText"
        app:titleTextColor="@color/text_primary"
        app:title=""
        app:contentInsetStart="0dp"
        app:contentInsetEnd="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 使用 ConstraintLayout 将标题数学居中于左右占位之间 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/pdf_list_left_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:visibility="invisible"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary"
                android:adjustViewBounds="true"
                android:scaleType="centerInside"
                android:contentDescription="@string/open_desc"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/pdf_list_right_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:visibility="invisible"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary"
                android:adjustViewBounds="true"
                android:scaleType="centerInside"
                android:contentDescription="@string/open_desc"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 左对齐标题：完全左对齐，移除右侧约束 -->
            <TextView
                android:id="@+id/pdf_list_center_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/aaguxilazhangguankeaideshen_2"
                android:gravity="center_vertical|start"
                android:includeFontPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/pdf_list_title"
                android:textAlignment="viewStart"
                android:textAppearance="@style/PDFToolbarTitleText"
                android:textColor="@color/text_primary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.533" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.appcompat.widget.Toolbar>

    <ListView
        android:id="@+id/pdf_list_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:divider="@color/progress_track"
        android:dividerHeight="1dp"
        app:layout_constraintTop_toBottomOf="@id/pdf_list_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:padding="12dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
