<resources>

    <style name="DrawerItemText" parent="TextAppearance.AppCompat.Body1">
        <item name="fontFamily">@font/aaguxilazhangguankeaideshen_2</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- 新增深色主题 （保留原有名为 AppTheme.Dark 的样式，新增下划线版本供代码使用） -->
    <style name="AppTheme.Dark" parent="Theme.AppCompat">
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/panel</item>
        <item name="colorAccent">@color/accent_2</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:buttonStyle">@style/AccentButton</item>
        <item name="android:fontFamily">@font/aaguxilazhangguankeaideshen_2</item>
        <!-- Preference theme overlay to ensure readable text and custom font in PreferenceFragmentCompat -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <!-- Ensure primary text color used by preferences -->
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <!-- 设置页专用主题，避免与其他样式命名冲突 -->
    <style name="JMF_Settings_Dark" parent="AppTheme.Dark" />

    <!-- 设置页无 ActionBar 主题，供 Activity 在使用 Toolbar 时使用 -->
    <style name="JMF_Settings_Dark_NoActionBar" parent="AppTheme.Dark">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- 按钮美化样式 -->
    <style name="AccentButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@color/accent</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/aaguxilazhangguankeaideshen_2</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:radius">8dp</item>
    </style>

    <style name="PDFToolbarTitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="fontFamily">@font/aaguxilazhangguankeaideshen_2</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="ThemeOverlay.Material3.Light.ActionBar" parent="ThemeOverlay.Material3.ActionBar">
        <item name="android:background">@color/colorAccent</item>
        <item name="android:titleTextColor">@color/white</item>
    </style>

    <style name="PreferenceThemeOverlay" parent="ThemeOverlay.AppCompat">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/aaguxilazhangguankeaideshen_2</item>
        <item name="android:background">@color/card_background</item>
    </style>

</resources>
