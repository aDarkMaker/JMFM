{
  "name": "JMFMobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "android": "react-native run-android",
    "android:dev": "bash scripts/dev-android.sh",
    "android:emu": "bash scripts/start-emulator.sh",
    "android:build": "cd android && ./gradlew assembleDebug",
    "ios": "react-native run-ios",
    "start": "react-native start --no-interactive",
    "test": "jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "bun scripts/verify-download.ts"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|react-native-images-to-pdf|react-native-blob-util|react-native-svg|react-native-safe-area-context|react-native-screens|react-native-gesture-handler|@react-navigation)/)"
    ]
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "@shopify/react-native-skia": "^2.11.0",
    "axios": "^1.19.0",
    "crypto-js": "^4.2.0",
    "node-html-parser": "^9.0.1",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-blob-util": "^0.24.10",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-images-to-pdf": "^0.2.1",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "react-native-svg": "^15.15.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.13",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
