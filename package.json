{
  "name": "JMFMobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && bun build ./src/web/index.html --outdir=dist --target=browser --define:process.env.NODE_ENV='\"production\"' && bun build ./src/core/pdf/worker-entry.ts --outfile=dist/pdf-worker.js --target=browser",
    "build:dev": "rm -rf dist && bun build ./src/web/index.html --outdir=dist --target=browser && bun build ./src/core/pdf/worker-entry.ts --outfile=dist/pdf-worker.js --target=browser",
    "cap:sync": "cap sync android",
    "cap:run": "cap run android",
    "dev": "bash scripts/dev-android.sh",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "verify": "bun scripts/verify-download.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capawesome/capacitor-file-picker": "^8.0.4",
    "axios": "^1.19.0",
    "crypto-js": "^4.2.0",
    "gsap": "^3.15.0",
    "node-html-parser": "^9.0.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/bun": "^1.4.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.4",
    "eslint": "^8.19.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
